# Discord Bot Token (From Discord Developer Portal -> Bot -> Token)
DISCORD_TOKEN=your_discord_bot_token_here

# AI Provider: "gemini" or "openai" (default: gemini)
AI_PROVIDER=gemini

# Google Gemini API Key (Get at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: OpenAI API Key (Get at https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Specific AI model name override
# Default for Gemini: gemini-2.5-flash
# Default for OpenAI: gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini
